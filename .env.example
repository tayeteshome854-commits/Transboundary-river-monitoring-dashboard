# Ethiopian Transboundary River Monitoring Dashboard — configuration template
#
# Copy to `.env` and edit. `.env` is git-ignored: never commit credentials.
#   cp .env.example .env

# ---------------------------------------------------------------- Earth Engine
# Project that holds the basin assets / has Earth Engine access.
EE_PROJECT_ID=enduring-art-494812-u2

# Optional: absolute path to a service-account JSON key for unattended servers.
# Leave empty for interactive (user) credentials created by `ee.Authenticate()`.
# EE_SERVICE_ACCOUNT_KEY=/etc/secrets/ee-service-account.json

# Optional: root of uploaded Earth Engine assets (basins, buffers, Green Legacy).
# Statistics do not require these — geometry is read from shapefiles/.
# EE_ASSET_ROOT=projects/enduring-art-494812-u2/assets

# Per-call timeout and retry policy for Earth Engine work.
EE_TIMEOUT_SECONDS=90
EE_MAX_RETRIES=2
EE_RETRY_BACKOFF_SECONDS=1.5

# ------------------------------------------------------------- data processing
# Scene-level cloud screen (Sentinel-2 CLOUDY_PIXEL_PERCENTAGE).
MAX_CLOUD_COVER_PERCENT=70

# Minimum valid observations behind a published statistic.
MIN_OBSERVATIONS=1

# Freshness thresholds, in days, used to label the latest observation.
FRESH_DAYS=16
STALE_DAYS=45

# Default look-back window when the caller does not give dates.
DEFAULT_WINDOW_DAYS=90

# Simplification tolerance (metres) applied when vector data is served as GeoJSON.
BASIN_SIMPLIFY_M=150
BUFFER_SIMPLIFY_M=60
GREEN_SIMPLIFY_M=25

# --------------------------------------------------------------------- caching
CACHE_TTL_SECONDS=3600
CACHE_MAX_ITEMS=256

# --------------------------------------------------------- demonstration data
# Synthetic, clearly labelled data used only for interface development and only
# when Earth Engine is unavailable. Keep this false in any operational deployment.
ALLOW_DEMO_MODE=false

# ----------------------------------------------------------------------- server
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
HOST=0.0.0.0
PORT=8000

# Comma separated list of allowed browser origins. Use exact origins in
# production; credentials are only enabled when this is not "*".
CORS_ORIGINS=*

# ------------------------------------------------------------------- hydrology
# Name of a registered gauge/telemetry adapter (see app/hydrology.py).
# Leave empty: the dashboard then states that hydrological monitoring is not
# connected instead of showing simulated values.
# HYDROLOGY_PROVIDER=
